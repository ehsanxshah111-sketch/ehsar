PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ehsar
JWT_SECRET=change_this_to_a_long_random_secret_string
CLIENT_URL=http://localhost:5173
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=Ehsar@Admin123

# Optional - only needed for the "upload image" button in the admin panel.
# Free account at https://cloudinary.com. Without these, admins can still
# add products by pasting image URLs directly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order notification emails - sent to you every time a customer places an
# order, via Resend (resend.com) rather than Gmail directly, since Gmail's
# SMTP connection is unreliable from Vercel's serverless functions.
#
# 1. Sign up free at https://resend.com (no credit card needed)
# 2. Dashboard -> API Keys -> Create API Key -> paste it below as RESEND_API_KEY
# 3. ADMIN_EMAIL is where YOU want to receive order notifications - for a
#    quick start, use the same email you signed up to Resend with, and leave
#    RESEND_FROM blank (it defaults to Resend's shared "onboarding@resend.dev"
#    address, which can only send TO that one signup email).
# 4. To receive at any email address instead (recommended once you're live),
#    add and verify your own domain under Dashboard -> Domains, then set
#    RESEND_FROM to an address at that domain, e.g. orders@ehsar.store
RESEND_API_KEY=
RESEND_FROM=
ADMIN_EMAIL=
