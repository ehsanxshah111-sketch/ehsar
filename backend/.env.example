PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ehsar
JWT_SECRET=change_this_to_a_long_random_secret_string
CLIENT_URL=http://localhost:5173
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=Ehsar@Admin123

# Optional - only needed for the "upload image" button in the admin panel.
# Free account at https://cloudinary.com. Without these, admins can still
# add products by pasting image URLs directly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order notification emails - sent to you every time a customer places an
# order. EMAIL_USER/EMAIL_PASS is the Gmail account that SENDS the email;
# ADMIN_EMAIL is who RECEIVES it (defaults to EMAIL_USER if left blank, so
# you can just use one Gmail account for both).
#
# EMAIL_PASS must be a 16-character Gmail "App Password", NOT your normal
# Gmail password (Gmail blocks normal passwords for this). To create one:
# 1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Go to myaccount.google.com/apppasswords
# 3. Create an app password (name it anything, e.g. "Ehsar Store") and paste
#    the 16-character code below with no spaces.
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
